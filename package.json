{
  "name": "shia-matrimonial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-deployment-config.mjs && prisma generate && node scripts/database.mjs setup && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "demo:seed": "node scripts/seed-running-demo.mjs",
    "db:setup": "node scripts/database.mjs setup",
    "db:check": "node scripts/database.mjs check",
    "db:backup": "node scripts/database.mjs backup",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "lucide-react": "1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prisma": "^7.10.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
