generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  profile  Profile?
  support  Support[]
  coupons  Coupon[]
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Profile {
  id         String  @id
  userId     String  @unique @map("user_id")
  name       String
  email      String
  dob        String
  gender     String
  city       String
  profession String
  education  String
  sect       String
  language   String
  marital    String
  manager    String
  about      String
  values     String
  prefMin    Int     @default(23) @map("pref_min")
  prefMax    Int     @default(35) @map("pref_max")
  prefCity   String  @default("") @map("pref_city")
  photoKey   String? @map("photo_key")
  status     String  @default("pending")
  fee        String  @default("unpaid")
  oathAt     String  @map("oath_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo            Photo?
  sentConnections  Connection[] @relation("sender")
  recvConnections  Connection[] @relation("receiver")
  sentMessages     Message[]    @relation("messageSender")
  blockerBlocks    Block[]      @relation("blocker")
  blockedBlocks    Block[]      @relation("blocked")
  orders           Order[]

  @@map("profiles")
}

model Photo {
  key       String   @id
  profileId String   @unique @map("profile_id")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Connection {
  id            String   @id @default(uuid())
  senderId      String   @map("sender")
  receiverId    String   @map("receiver")
  pair          String   @unique
  status        String   @default("pending")
  note          String
  senderPhoto   Boolean  @default(false) @map("sender_photo")
  receiverPhoto Boolean  @default(false) @map("receiver_photo")
  createdAt     DateTime @default(now()) @map("created_at")
  acceptedAt    DateTime? @map("accepted_at")

  sender   Profile   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Profile   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("connections")
}

model Message {
  id           String   @id @default(uuid())
  connectionId String   @map("connection_id")
  senderId     String   @map("sender")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     Profile    @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Support {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  email     String
  category  String
  message   String
  status    String   @default("pending")
  coupon    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support")
}

model Coupon {
  code       String    @id
  userId     String    @map("user_id")
  redeemedAt DateTime? @map("redeemed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coupons")
}

model Order {
  id        String   @id
  profileId String   @map("profile_id")
  paymentId String?  @unique @map("payment_id")
  status    String   @default("created")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker")
  blockedId String   @map("blocked")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  blocker Profile @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}
